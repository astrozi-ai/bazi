{
  "name": "bazi-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -b packages/bazi packages/mcp",
    "test": "bun test --path-ignore-patterns='**/dist/**' --path-ignore-patterns='apps/**'",
    "check": "bun run typecheck && bun run test && bun run check:public",
    "changeset": "changeset",
    "check:public": "bun scripts/public-surface/check.ts",
    "engine:nsh": "bun scripts/build-nsh-engine.ts",
    "theme:playground": "bun scripts/theme/build-playground-theme.ts"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.7",
    "@types/bun": "1.3.1",
    "typescript": "5.9.3"
  }
}
